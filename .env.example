# Express API'nin dinleyeceği port
PORT=3000


# Fal normalde günde bir kez açılır. Yerelde hızlı test için 60 yapabilirsin.
EXPO_PUBLIC_FORTUNE_COOLDOWN_SECONDS=86400

# Çark normalde 24 saatte bir çevrilir. Yerelde hızlı test için 60 yapabilirsin.
WHEEL_COOLDOWN_SECONDS=86400
# Yerel Docker PostgreSQL bağlantısı
DATABASE_URL=postgresql://postgres:postgrespassword@127.0.0.1:5433/portfolio_league

# JWT ayarları (gerçek sırrı bu dosyaya yazma; .env kullan)
JWT_ACCESS_SECRET=at-least-32-character-local-secret-change-me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# Gemini (davranış yorumu) — İSTEĞE BAĞLI
#
# Yoksa özellik sessizce kapanır: /me/behavior bulguları döndürmeye devam
# eder, yalnızca `comment` alanı null olur. JWT sırrının aksine eksikliği
# uygulamayı DURDURMAZ — sebebi apps/api/src/behavior/narrator.ts'te yazılı.
#
# Anahtar: https://aistudio.google.com/apikey (ücretsiz katman var)
# ⚠️ Bu anahtar YALNIZCA sunucuda. Mobil uygulamaya (EXPO_PUBLIC_*) asla
# konmayacak — konursa paketten çıkarılıp başkası tarafından harcanır.
GEMINI_API_KEY=
# Model adı değişirse tek satırda düzeltilir, kod değişmez.
GEMINI_MODEL=gemini-3.1-flash-lite
